<Window x:Class="PetShopCare.Views.EdicaoTutorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Editar Tutor" Width="500" 
        Icon="pack://application:,,,/Images/logo.png"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Grid Margin="30,30,30,20">
        <StackPanel>
            <TextBlock Text="Editar Tutor" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,30"/>

            <TextBox materialDesign:HintAssist.Hint="Nome Completo *" Text="{Binding ClienteEditado.Nome, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>
            <TextBox materialDesign:HintAssist.Hint="CPF *" Text="{Binding ClienteEditado.CPF, UpdateSourceTrigger=PropertyChanged}" TextChanged="CpfTextBox_TextChanged" Margin="0,0,0,15"/>
            <TextBox materialDesign:HintAssist.Hint="Telefone *" Text="{Binding ClienteEditado.Telefone, UpdateSourceTrigger=PropertyChanged}" TextChanged="TelefoneTextBox_TextChanged" Margin="0,0,0,15"/>
            <TextBox materialDesign:HintAssist.Hint="Endereco (Opcional)" Text="{Binding ClienteEditado.Endereco, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

            <TextBlock Text="{Binding MensagemErro}" Foreground="Red" HorizontalAlignment="Center" Margin="0,10"/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="EXCLUIR" Command="{Binding ExcluirCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#E74C3C" FontWeight="SemiBold"/>

                <Button Grid.Column="2" Content="CANCELAR" Command="{Binding CancelarCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#7F8C8D" Margin="0,0,10,0" FontWeight="SemiBold"/>

                <Button Grid.Column="3" Content="ALTERAR" Command="{Binding AlterarCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#3498DB" BorderBrush="#3498DB" Foreground="White" FontWeight="SemiBold" Padding="25,0"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>