<UserControl x:Class="PetShopCare.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#F5F6FA">

	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,20">
			<TextBlock Text="Dashboard - Resumo Geral" FontSize="26" FontWeight="Bold" Foreground="#2C3E50"/>
			<TextBlock Text="Acompanhe as métricas e alertas operacionais do petshop em tempo real." FontSize="14" Foreground="#7F8C8D" Margin="0,5,0,0"/>
		</StackPanel>

		<Grid Grid.Row="1" Margin="0,0,0,20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1*"/>
				<ColumnDefinition Width="1*"/>
				<ColumnDefinition Width="1*"/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,15,0" BorderBrush="#E0E0E0" BorderThickness="1">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" VerticalAlignment="Center">
						<TextBlock Text="Faturamento Hoje" FontSize="14" Foreground="#7F8C8D" FontWeight="SemiBold"/>
						<TextBlock Text="{Binding FaturamentoHoje, StringFormat='R$ {0:N2}'}" FontSize="28" FontWeight="Bold" Foreground="#27AE60" Margin="0,5,0,0"/>
					</StackPanel>
					<materialDesign:PackIcon Grid.Column="1" Kind="CashMultiple" Width="40" Height="40" Foreground="#27AE60" VerticalAlignment="Center"/>
				</Grid>
			</Border>

			<Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="7.5,0,7.5,0" BorderBrush="#E0E0E0" BorderThickness="1">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" VerticalAlignment="Center">
						<TextBlock Text="Serviços Agendados/Dia" FontSize="14" Foreground="#7F8C8D" FontWeight="SemiBold"/>
						<TextBlock Text="{Binding ServicosHoje}" FontSize="32" FontWeight="Bold" Foreground="#2980B9" Margin="0,5,0,0"/>
					</StackPanel>
					<materialDesign:PackIcon Grid.Column="1" Kind="CalendarClock" Width="40" Height="40" Foreground="#2980B9" VerticalAlignment="Center"/>
				</Grid>
			</Border>

			<Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" Margin="15,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" VerticalAlignment="Center">
						<TextBlock Text="Itens em Estoque Crítico" FontSize="14" Foreground="#7F8C8D" FontWeight="SemiBold"/>
						<TextBlock Text="{Binding ProdutosEstoqueCritico.Count}" FontSize="32" FontWeight="Bold" Foreground="#C0392B" Margin="0,5,0,0"/>
					</StackPanel>
					<materialDesign:PackIcon Grid.Column="1" Kind="AlertOctagon" Width="40" Height="40" Foreground="#C0392B" VerticalAlignment="Center"/>
				</Grid>
			</Border>
		</Grid>
		<Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20" BorderBrush="#E0E0E0" BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>
				<TextBlock Grid.Row="0" Text="Evolução do Faturamento (Últimos 7 dias)" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,15"/>

				<lvc:CartesianChart Grid.Row="1"
                                    Series="{Binding FaturamentoSeries}"
                                    XAxes="{Binding EixoX}"
                                    YAxes="{Binding EixoY}"
                                    TooltipPosition="Top"
                                    MinHeight="200">
				</lvc:CartesianChart>
			</Grid>
		</Border>

		<Border Grid.Row="3" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Margin="0,0,0,15">
					<TextBlock Text="⚠️ Produtos que necessitam de reposição imediata" FontSize="18" FontWeight="Bold" Foreground="#C0392B"/>
					<TextBlock Text="Itens cujo estoque atual atingiu ou ultrapassou o estoque mínimo configurado." FontSize="13" Foreground="#7F8C8D"/>
				</StackPanel>

				<DataGrid Grid.Row="1" ItemsSource="{Binding ProdutosEstoqueCritico}" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0" RowHeight="45">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Código de Barras" Binding="{Binding CodigoBarras}" Width="1.5*">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="VerticalAlignment" Value="Center"/>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>
						<DataGridTextColumn Header="Nome do Produto" Binding="{Binding Nome}" Width="3*">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="VerticalAlignment" Value="Center"/>
									<Setter Property="FontWeight" Value="SemiBold"/>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>
						<DataGridTextColumn Header="Estoque Atual" Binding="{Binding EstoqueAtual}" Width="1.2*">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="VerticalAlignment" Value="Center"/>
									<Setter Property="Foreground" Value="#C0392B"/>
									<Setter Property="FontWeight" Value="Bold"/>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>
						<DataGridTextColumn Header="Estoque Mínimo" Binding="{Binding EstoqueMinimo}" Width="1.2*">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="VerticalAlignment" Value="Center"/>
									<Setter Property="Foreground" Value="#7F8C8D"/>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Grid>
		</Border>
	</Grid>
</UserControl>