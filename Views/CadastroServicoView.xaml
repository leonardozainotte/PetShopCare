<Window x:Class="PetShopCare.Views.CadastroServicoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding TituloAcao}" Width="550" 
        Icon="pack://application:,,,/Images/logo.png"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False">

    <Grid Margin="30,30,30,20">
        <StackPanel>
            <TextBlock Text="{Binding TituloAcao}" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,30"/>

            <TextBox materialDesign:HintAssist.Hint="Nome do Serviço *" 
                     Text="{Binding ServicoAtual.Nome, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,25" FontSize="15"/>

            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Valor (R$) *" 
                         Text="{Binding ServicoAtual.Preco, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         FontSize="15"/>

                <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Tempo Estimado (Minutos) *" 
                         Text="{Binding ServicoAtual.TempoEstimadoMinutos, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         FontSize="15"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="CANCELAR" Command="{Binding CancelarCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#7F8C8D" Margin="0,0,10,0" FontWeight="SemiBold"/>

                <Button Content="SALVAR" Command="{Binding SalvarCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" Background="#1ABC9C" BorderBrush="#1ABC9C" Foreground="White" FontWeight="SemiBold" Padding="25,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>