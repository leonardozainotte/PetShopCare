<Window x:Class="PetShopCare.Views.EdicaoPetView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Editar Pet" Width="600" 
        Icon="pack://application:,,,/Images/logo.png"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Grid Margin="35,30,35,25">
        <StackPanel>
            <TextBlock Text="Editar Dados do Pet" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,25"/>

            <ComboBox materialDesign:HintAssist.Hint="Tutor Responsável *" 
                      ItemsSource="{Binding TutoresDisponiveis}" 
                      DisplayMemberPath="Nome" 
                      SelectedValuePath="Id" 
                      SelectedValue="{Binding PetEditado.ClienteId, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,0,15"/>

            <TextBox materialDesign:HintAssist.Hint="Nome do Pet *" 
                     Text="{Binding PetEditado.Nome, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,15"/>

            <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="Espécie *" 
                          ItemsSource="{Binding EspeciesDisponiveis}" 
                          SelectedItem="{Binding EspecieSelecionada, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="Raça" 
                          ItemsSource="{Binding RacasDisponiveis}" 
                          Text="{Binding PetEditado.Raca, UpdateSourceTrigger=PropertyChanged}" 
                          IsEditable="True"/>
            </Grid>

            <Grid Margin="0,25,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="Sexo" 
                          ItemsSource="{Binding SexosDisponiveis}"
                          SelectedItem="{Binding PetEditado.Sexo, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Peso (kg)" 
                         Text="{Binding PesoTexto, UpdateSourceTrigger=PropertyChanged}"/>

                <DatePicker Grid.Column="4" materialDesign:HintAssist.Hint="Data de Nascimento"
                            SelectedDate="{Binding PetEditado.DataNascimento, UpdateSourceTrigger=PropertyChanged}"
                            Language="pt-BR"/>
            </Grid>

            <TextBox materialDesign:HintAssist.Hint="Observações Médicas / Comportamentais" 
                     Text="{Binding PetEditado.Observacoes, UpdateSourceTrigger=PropertyChanged}" 
                     TextWrapping="Wrap" MaxLines="3" Margin="0,25,0,0"/>

            <TextBlock Text="{Binding MensagemErro}" Foreground="Red" HorizontalAlignment="Center" Margin="0,15,0,0"/>

			<Grid Margin="0,20,0,0">
				<Button Content="EXCLUIR" Command="{Binding ExcluirCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E74C3C" HorizontalAlignment="Left" FontWeight="SemiBold"/>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<Button Content="CANCELAR" Command="{Binding CancelarCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#7F8C8D" Margin="0,0,15,0" FontWeight="SemiBold"/>
					<Button Content="ATUALIZAR PET" Command="{Binding SalvarCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#3498DB" BorderBrush="#3498DB" Foreground="White" Width="140" FontWeight="SemiBold"/>
				</StackPanel>
			</Grid>
        </StackPanel>
    </Grid>
</Window>