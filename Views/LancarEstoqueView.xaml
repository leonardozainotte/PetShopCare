<Window x:Class="PetShopCare.Views.LancarEstoqueView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Movimentação de Estoque" Width="400" SizeToContent="Height"
        Icon="pack://application:,,,/Images/logo.png"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="Lançar Movimentação" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="{Binding ProdutoAlvo.Nome}" FontSize="14" Foreground="#7F8C8D" Margin="0,5,0,20"/>

            <ComboBox materialDesign:HintAssist.Hint="Tipo de Operação" 
                      SelectedValue="{Binding Movimentacao.TipoMovimentacao}"
                      SelectedValuePath="Content">
                <ComboBoxItem Content="Entrada"/>
                <ComboBoxItem Content="Saída"/>
            </ComboBox>

            <TextBox materialDesign:HintAssist.Hint="Quantidade" Margin="0,15,0,0"
                     Text="{Binding Movimentacao.Quantidade, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBox materialDesign:HintAssist.Hint="Origem / Justificativa (Ex: NF 123)" Margin="0,15,0,0"
                     Text="{Binding Movimentacao.Origem, UpdateSourceTrigger=PropertyChanged}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
                <Button Content="CANCELAR" 
                        Command="{Binding CancelarCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Foreground="#7F8C8D" 
                        Margin="0,0,15,0" 
                        FontWeight="SemiBold"/>

                <Button Content="CONFIRMAR LANÇAMENTO" 
                        Command="{Binding ConfirmarCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#2980B9" 
                        BorderBrush="#2980B9" 
                        Foreground="White" 
                        FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>