<UserControl x:Class="PetShopCare.Views.TutorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:PetShopCare.Converters"
             Background="#F5F6FA">

	<UserControl.Resources>
		<converters:CpfConverter x:Key="CpfConverter"/>
		<converters:TelefoneConverter x:Key="TelefoneConverter"/>
	</UserControl.Resources>

	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Margin="0,0,0,20">
			<StackPanel Orientation="Vertical">
				<TextBlock Text="Gestão de Tutores" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
				<TextBlock Text="Gerencie os clientes e proprietários de pets do sistema." FontSize="14" Foreground="#7F8C8D" Margin="0,5,0,0"/>
			</StackPanel>
			<Button Command="{Binding AbrirCadastroCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1ABC9C" BorderThickness="0" Padding="10,00">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon Kind="Plus" Width="20" Height="20" Margin="0,0,8,0" Foreground="White"/>
					<TextBlock Text="NOVO TUTOR" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
		</Grid>

		<Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15">
			<DataGrid ItemsSource="{Binding Tutores}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Nome Completo" Width="*" Binding="{Binding Nome}">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="VerticalAlignment" Value="Center"/>
								<Setter Property="Margin" Value="10,0,0,0"/>
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>

					<DataGridTextColumn Header="CPF" Width="150" Binding="{Binding CPF, Converter={StaticResource CpfConverter}}">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="VerticalAlignment" Value="Center"/>
								<Setter Property="HorizontalAlignment" Value="Center"/>
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>

					<DataGridTextColumn Header="Telefone" Width="150" Binding="{Binding Telefone, Converter={StaticResource TelefoneConverter}}">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="VerticalAlignment" Value="Center"/>
								<Setter Property="HorizontalAlignment" Value="Center"/>
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>

					<DataGridTextColumn Header="Endereço" Width="500" Binding="{Binding Endereco}">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="VerticalAlignment" Value="Center"/>
								<Setter Property="Margin" Value="10,0,10,0"/>
								<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>

					<DataGridTemplateColumn Width="80">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Button Command="{Binding DataContext.AbrirEdicaoCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
									CommandParameter="{Binding}"
									Style="{StaticResource MaterialDesignToolButton}"
									Width="35" Height="35" Padding="0" Margin="0" Cursor="Hand" ToolTip="Editar Tutor"
									HorizontalAlignment="Center">
									<materialDesign:PackIcon Kind="Pencil" Foreground="#3498DB" Width="20" Height="20"/>
								</Button>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Border>
	</Grid>
</UserControl>