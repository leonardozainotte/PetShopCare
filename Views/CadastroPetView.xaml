<Window x:Class="PetShopCare.Views.CadastroPetView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Cadastrar Novo Pet" Width="550" 
        Icon="pack://application:,,,/Images/logo.png"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Grid Margin="30,30,30,20">
        <StackPanel>
            <TextBlock Text="Cadastrar Novo Pet" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,30"/>

            <ComboBox materialDesign:HintAssist.Hint="Selecione o Tutor Responsável *" 
                      ItemsSource="{Binding TutoresDisponiveis}" 
                      DisplayMemberPath="Nome" 
                      SelectedValuePath="Id" 
                      SelectedValue="{Binding NovoPet.ClienteId, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,0,15" IsEditable="True"/>

            <TextBox materialDesign:HintAssist.Hint="Nome do Pet *" Text="{Binding NovoPet.Nome, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

            <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="Espécie *" 
                          ItemsSource="{Binding EspeciesDisponiveis}" 
                          SelectedItem="{Binding EspecieSelecionada, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="Raça" 
                          ItemsSource="{Binding RacasDisponiveis}" 
                          Text="{Binding NovoPet.Raca, UpdateSourceTrigger=PropertyChanged}" 
                          IsEditable="True"/>
            </Grid>

            <Grid Margin="0,25,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="Sexo" 
                          ItemsSource="{Binding SexosDisponiveis}"
                          SelectedItem="{Binding NovoPet.Sexo, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Peso (kg)" 
                         Text="{Binding PesoTexto, UpdateSourceTrigger=PropertyChanged}"/>

                <DatePicker Grid.Column="4" materialDesign:HintAssist.Hint="Data de Nascimento"
                            SelectedDate="{Binding NovoPet.DataNascimento, UpdateSourceTrigger=PropertyChanged}"
                            Language="pt-BR"/>
            </Grid>

            <Grid Margin="0,25,0,0">
                <TextBox materialDesign:HintAssist.Hint="Observações / Condições Médicas" Text="{Binding NovoPet.Observacoes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MaxLines="3" Margin="0,0,0,15"/>
            </Grid>

            <TextBlock Text="{Binding MensagemErro}" Foreground="Red" HorizontalAlignment="Center" Margin="0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="CANCELAR" Command="{Binding CancelarCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#7F8C8D" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <Button Content="SALVAR" Command="{Binding SalvarCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1ABC9C" BorderBrush="#1ABC9C" Foreground="White" FontWeight="SemiBold" Padding="25,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>