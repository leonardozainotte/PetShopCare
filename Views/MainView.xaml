<Window x:Class="PetShopCare.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:PetShopCare.Views"
        xmlns:viewmodels="clr-namespace:PetShopCare.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="PetShopCare" Height="720" Width="1280"
        Icon="pack://application:,,,/Images/logo.png"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource ColorBackground}">

	<Window.Resources>
		<DataTemplate DataType="{x:Type viewmodels:ConfiguracoesViewModel}">
			<views:ConfiguracoesView/>
		</DataTemplate>
		
		<DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
			<views:DashboardView/>
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:TutorViewModel}">
			<views:TutorView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:PetViewModel}">
			<views:PetView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:ServicoViewModel}">
			<views:ServicoView/>
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:PDVViewModel}">
			<views:PDVView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:ProdutoViewModel}">
			<views:ProdutoView/>
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:AgendamentoViewModel}">
			<views:AgendamentoView/>
		</DataTemplate>

		<Style x:Key="MenuButtonStyle" TargetType="RadioButton">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Height" Value="50"/>
			<Setter Property="Margin" Value="10,5"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter Property="Background" Value="#E0E0E0"/>
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#F5F5F5"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="250"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Border Grid.Column="0" Background="{StaticResource ColorSurface}" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
			<StackPanel>
				<Image Source="pack://application:,,,/Images/logo.png"
                       Height="80" Width="100"
                       Margin="0,30,0,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

				<TextBlock Text="PetShop Care" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource ColorPrimary}" HorizontalAlignment="Center" Margin="0,30,0,40"/>

				<!-- VISIBILIDADE DO DASHBOARD APLICADA AQUI -->
				<RadioButton GroupName="MenuLateral" IsChecked="True" Command="{Binding AbrirDashboardCommand}" Style="{StaticResource MenuButtonStyle}" Visibility="{Binding VisibilidadeDashboard}">
					<Grid Margin="20,0,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<materialDesign:PackIcon Grid.Column="0" Kind="ViewDashboardOutline" Width="24" Height="24" Foreground="{StaticResource ColorPrimary}" VerticalAlignment="Center"/>
						<TextBlock Grid.Column="1" Text="Dashboard" FontSize="16" FontWeight="Medium" Foreground="{StaticResource ColorTextPrimary}" VerticalAlignment="Center" Margin="15,0,0,0"/>
					</Grid>
				</RadioButton>

				<RadioButton GroupName="MenuLateral" Command="{Binding AbrirTutoresCommand}" Style="{StaticResource MenuButtonStyle}">
					<Grid Margin="20,0,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<materialDesign:PackIcon Grid.Column="0" Kind="AccountMultipleOutline" Width="24" Height="24" Foreground="{StaticResource ColorPrimary}" VerticalAlignment="Center"/>
						<TextBlock Grid.Column="1" Text="Tutores" FontSize="16" FontWeight="Medium" Foreground="{StaticResource ColorTextPrimary}" VerticalAlignment="Center" Margin="15,0,0,0"/>
					</Grid>
				</RadioButton>

				<RadioButton GroupName="MenuLateral" Command="{Binding AbrirProntuariosCommand}" Style="{StaticResource MenuButtonStyle}">
					<Grid Margin="20,0,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<materialDesign:PackIcon Grid.Column="0" Kind="Dog" Width="24" Height="24" Foreground="{StaticResource ColorPrimary}" VerticalAlignment="Center"/>
						<TextBlock Grid.Column="1" Text="Prontuários Pets" FontSize="16" FontWeight="Medium" Foreground="{StaticResource ColorTextPrimary}" VerticalAlignment="Center" Margin="15,0,0,0"/>
					</Grid>
				</RadioButton>

				<RadioButton GroupName="MenuLateral" Command="{Binding AbrirServicosCommand}" Style="{StaticResource MenuButtonStyle}">
					<Grid Margin="20,0,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<materialDesign:PackIcon Grid.Column="0" Kind="ContentCut" Width="24" Height="24" Foreground="{StaticResource ColorPrimary}" VerticalAlignment="Center"/>
						<TextBlock Grid.Column="1" Text="Serviços" FontSize="16" FontWeight="Medium" Foreground="{StaticResource ColorTextPrimary}" VerticalAlignment="Center" Margin="15,0,0,0"/>
					</Grid>
				</RadioButton>

				<!-- VISIBILIDADE DO PDV APLICADA AQUI -->
				<RadioButton GroupName="MenuLateral" Command="{Binding AbrirPdvCommand}" Style="{StaticResource MenuButtonStyle}" Visibility="{Binding VisibilidadePDV}">
					<Grid Margin="20,0,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<materialDesign:PackIcon Grid.Column="0" Kind="CartOutline" Width="24" Height="24" Foreground="{StaticResource ColorPrimary}" VerticalAlignment="Center"/>
						<TextBlock Grid.Column="1" Text="Ponto de Venda" FontSize="16" FontWeight="Medium" Foreground="{StaticResource ColorTextPrimary}" VerticalAlignment="Center" Margin="15,0,0,0"/>
					</Grid>
				</RadioButton>

				<!-- VISIBILIDADE DO ESTOQUE APLICADA AQUI -->
				<RadioButton GroupName="MenuLateral" Command="{Binding AbrirProdutosCommand}" Style="{StaticResource MenuButtonStyle}" Visibility="{Binding VisibilidadeEstoque}">
					<Grid Margin="20,0,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<materialDesign:PackIcon Grid.Column="0" Kind="PackageVariantClosed" Width="24" Height="24" Foreground="{StaticResource ColorPrimary}" VerticalAlignment="Center"/>
						<TextBlock Grid.Column="1" Text="Catálogo / Estoque" FontSize="16" FontWeight="Medium" Foreground="{StaticResource ColorTextPrimary}" VerticalAlignment="Center" Margin="15,0,0,0"/>
					</Grid>
				</RadioButton>

				<RadioButton GroupName="MenuLateral" Command="{Binding AbrirAgendamentoCommand}" Style="{StaticResource MenuButtonStyle}">
					<Grid Margin="20,0,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<materialDesign:PackIcon Grid.Column="0" Kind="CalendarClock" Width="24" Height="24" Foreground="{StaticResource ColorPrimary}" VerticalAlignment="Center"/>
						<TextBlock Grid.Column="1" Text="Agenda" FontSize="16" FontWeight="Medium" Foreground="{StaticResource ColorTextPrimary}" VerticalAlignment="Center" Margin="15,0,0,0"/>
					</Grid>
				</RadioButton>
			</StackPanel>
		</Border>

		<Grid Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="70"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<Border Grid.Row="0" Background="{StaticResource ColorSurface}" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="30,0">
				<Grid>
					<TextBlock Text="Dashboard Geral" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource ColorTextPrimary}" VerticalAlignment="Center"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

						<!-- 1. SAUDAÇÃO DINÂMICA DO USUÁRIO -->
						<TextBlock Text="{Binding SaudacaoUsuario}" FontSize="14" Foreground="{StaticResource ColorTextSecondary}" VerticalAlignment="Center" Margin="0,0,20,0"/>

						<!-- 2. BOTÃO DE CONFIGURAÇÕES (Engrenagem) -->
						<Button Command="{Binding AbrirConfiguracoesCommand}"
								Visibility="{Binding VisibilidadeConfiguracoes}"
								Style="{StaticResource MaterialDesignIconButton}"
								Width="40" Height="40"
								Margin="0,0,15,0"
								ToolTip="Administrar Funcionários">
							<materialDesign:PackIcon Kind="Cog" Foreground="#7F8C8D" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Button>

						<!-- 3. BOTÃO DE LOGOUT -->
						<Button Command="{Binding LogoutCommand}"
								Width="40" Height="40"
								Background="#F39C12"
								BorderThickness="0"
								Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
								ToolTip="Sair do Sistema">
							<materialDesign:PackIcon Kind="Logout" Foreground="White" Width="20" Height="20"/>
						</Button>

					</StackPanel>
				</Grid>
			</Border>
			<ContentControl Grid.Row="1" Content="{Binding TelaAtual}" Margin="0"/>
		</Grid>
	</Grid>
</Window>