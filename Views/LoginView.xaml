<Window x:Class="PetShopCare.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="PetShop Care - Login" Height="500" Width="400"
        Icon="pack://application:,,,/Images/logo.png"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        Background="White" FontFamily="Roboto">

    <Border BorderBrush="#E0E0E0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Botão de Fechar Customizado -->
            <Button Grid.Row="0" Command="{Binding FecharCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Style="{StaticResource MaterialDesignToolButton}" Margin="10" Foreground="#7F8C8D">
                <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
            </Button>

            <StackPanel Grid.Row="1" Margin="40,20,40,40" VerticalAlignment="Center">

                <!-- Logo ou Ícone Principal -->
                <materialDesign:PackIcon Kind="Paw" Width="80" Height="80" Foreground="#1ABC9C" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Bem-vindo ao" FontSize="16" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                <TextBlock Text="PetShop Care" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <!-- Campo de Usuário -->
                <TextBox materialDesign:HintAssist.Hint="Usuário" 
                         Text="{Binding LoginUsuario, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                         FontSize="16" Margin="0,0,0,25">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding EntrarCommand}" CommandParameter="{Binding ElementName=TxtSenha}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Campo de Senha (Repare no x:Name que usaremos para passar como parâmetro) -->
                <PasswordBox x:Name="TxtSenha" 
                             materialDesign:HintAssist.Hint="Senha" 
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" 
                             FontSize="16" Margin="0,0,0,10">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding EntrarCommand}" CommandParameter="{Binding ElementName=TxtSenha}"/>
                    </PasswordBox.InputBindings>
                </PasswordBox>

                <!-- Mensagem de Erro (Fica invisível se estiver vazia) -->
                <TextBlock Text="{Binding MensagemErro}" Foreground="#E74C3C" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,15" MinHeight="20"/>

                <!-- Botão Entrar -->
                <!-- Repare que enviamos a PasswordBox via CommandParameter -->
                <Button Command="{Binding EntrarCommand}" 
                        CommandParameter="{Binding ElementName=TxtSenha}" 
                        Content="ENTRAR" Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#1ABC9C" BorderBrush="#1ABC9C" Foreground="White" 
                        FontWeight="Bold" FontSize="16" Height="45" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>