<Window x:Class="PetShopCare.Views.CadastroProdutoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Novo Produto" Width="650" 
        Icon="pack://application:,,,/Images/logo.png"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Grid Margin="35,30,35,25">
        <StackPanel>
            <TextBlock Text="Cadastrar Novo Produto" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,25"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Nome do Produto *" 
                         Text="{Binding NovoProduto.Nome, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Código de Barras" 
                         Text="{Binding NovoProduto.CodigoBarras, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Marca" 
                         Text="{Binding NovoProduto.Marca, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="Categoria *" 
                          ItemsSource="{Binding CategoriasDisponiveis}"
                          Text="{Binding NovoProduto.Categoria, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"/>
            </Grid>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Preço de Custo (R$)" 
                         Text="{Binding PrecoCustoTexto, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Preço de Venda (R$) *" 
                         Text="{Binding PrecoVendaTexto, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Grid.Column="4" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Estoque Mínimo (Alerta)" 
                         Text="{Binding NovoProduto.EstoqueMinimo, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <TextBox materialDesign:HintAssist.Hint="Descrição Detalhada / Aplicação" 
                     Text="{Binding NovoProduto.Descricao, UpdateSourceTrigger=PropertyChanged}" 
                     TextWrapping="Wrap" MaxLines="3" Margin="0,20,0,0"/>

            <TextBlock Text="{Binding MensagemErro}" Foreground="Red" HorizontalAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="CANCELAR" Command="{Binding CancelarCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#7F8C8D" Margin="0,0,15,0" FontWeight="SemiBold"/>
                <Button Content="SALVAR" Command="{Binding SalvarCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1ABC9C" BorderBrush="#1ABC9C" Foreground="White" Width="120" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>